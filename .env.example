# Copy to .env and fill in. All keys map to fields in src/memory/config.py.

ANTHROPIC_API_KEY=

# Neo4j (password must be at least 8 characters)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memory-dev-password
NEO4J_DATABASE=neo4j

# Redis (arq queue + ObservationLog cache)
REDIS_URL=redis://localhost:6379/0

# Ollama: native install or `docker compose --profile ollama up -d`
OLLAMA_URL=http://localhost:11434
